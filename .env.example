# Pollinations Flux — запасной клиентский URL, ключа НЕ требует.

# Gemini (анализ фото + чат). Секреты только на сервере, без NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Replicate ControlNet Depth — основной генератор (/api/generate).
# Публичная SDXL Depth: исходное фото уходит как `image`, глубина считается на стороне модели.
REPLICATE_API_TOKEN=
REPLICATE_CONTROLNET_MODEL=lucataco/sdxl-controlnet-depth:465fb41789dc2203a9d7158be11d1d2570606a039c65e0e236fd329b5eecb10c
REPLICATE_CONTROLNET_FALLBACK=lucataco/sdxl-controlnet-depth:465fb41789dc2203a9d7158be11d1d2570606a039c65e0e236fd329b5eecb10c

# Hugging Face — опциональный запасной генератор.
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
